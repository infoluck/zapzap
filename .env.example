# Conexão PostgreSQL usada pelo Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zapzap?schema=public"

# Porta do servidor (opcional, padrão 3000)
PORT=3001

# URL pública do app (usada no link de confirmação enviado por e-mail)
APP_URL="http://localhost:3001"

# Segredo para assinar a sessão. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# SMTP para enviar o e-mail de confirmação. Sem SMTP_HOST, em desenvolvimento o link aparece no console do servidor.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="WhatsApp Connect <no-reply@seudominio.com>"

# Administrador(es): quem vê a área de configuração do servidor Evolution (separe vários por vírgula)
ADMIN_EMAILS="admin@seudominio.com"

# Chave para criptografar segredos no banco (ex.: a chave da Evolution de cada usuário).
# Opcional: se vazia, usa o JWT_SECRET. Trocar o valor exige que cada usuário salve a chave de novo.
SETTINGS_ENCRYPTION_KEY=""

# Só para ambiente de um único usuário confiável: permite que a Evolution esteja em rede interna/localhost.
# Em produção multiusuário deixe sem definir (bloqueia endereços internos).
# ALLOW_PRIVATE_EVOLUTION_HOSTS="true"

# Hosts internos que podem ser usados como URL da Evolution (separe por vírgula, com porta se houver).
# Necessário quando o app e a Evolution estão no mesmo servidor e o endereço público não é alcançável de dentro.
# Ex.: EVOLUTION_TRUSTED_HOSTS="evolution:8080,meuprojeto_evolution:8080"
# EVOLUTION_TRUSTED_HOSTS=""
